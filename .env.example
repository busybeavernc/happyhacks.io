# happyhacks.io settings. The installer copies this to .env (next to wsgi.py) and fills in SECRET_KEY.
# Edit .env on the server, then restart:   sudo supervisorctl restart happyhacks
# Keep .env private. It is never served by the website and is not overwritten by updates.

# Port gunicorn listens on (127.0.0.1 only). Must match the App Port of the site in CloudPanel.
APP_PORT=9010

# Flask secret key. The installer generates it.
SECRET_KEY=

# Password for /admin (run the deploy from the web). The installer generates one and prints it once.
# Change it here, then: sudo supervisorctl restart happyhacks
ADMIN_PASSWORD=

# ---- Accounts (happyhacks.io/account) -----------------------------------------------------------------
# The address people use to reach the site (used in sign-in links).
PUBLIC_URL=https://happyhacks.io

# MySQL / MariaDB for accounts: create a database in CloudPanel > Databases and fill these in.
# Left empty, accounts are kept in a SQLite file in DATA_DIR (fine for trying it out; use MySQL for real users).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DATA_DIR=

# send (default) | log   (log: write codes to the app log instead of sending them; for setting up and testing)
AUTH_DELIVERY=send

# Email: any SMTP mailbox. The same settings as zipzip's .env work (SMTP_* or the MAIL_* names).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Happy Hacks <hello@happyhacks.io>

# Text messages (optional; Telnyx). Sign-in by text works only for numbers an account has confirmed.
TELNYX_API_KEY=
TELNYX_FROM=
TELNYX_MESSAGING_PROFILE_ID=

# ---- Apps that use "Sign in with Happy Hacks" ------------------------------------------------------------
# Added with:  python -m happyhacks.sso add zipzip "ZipZip" https://zipzip.busybeavernc.com/auth/happyhacks/callback
HH_CLIENTS=
