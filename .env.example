# happyhacks.io settings. The installer copies this to .env (next to wsgi.py) and fills in SECRET_KEY.
# Edit .env on the server, then restart:   sudo supervisorctl restart happyhacks
# Keep .env private. It is never served by the website and is not overwritten by updates.

# Port gunicorn listens on (127.0.0.1 only). Must match the App Port of the site in CloudPanel.
APP_PORT=9010

# Flask secret key. The installer generates it.
SECRET_KEY=
